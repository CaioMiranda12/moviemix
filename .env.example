# Somente para desenvolvimento local. Nunca use estas credenciais em producao.
# O Compose usa esta senha ao criar o volume PostgreSQL pela primeira vez.
POSTGRES_PASSWORD=moviemix_dev

# Usada quando a API ou o Drizzle rodam no Windows (fora do Docker).
# O PostgreSQL esta publicado em localhost:5433; dentro do Docker, em db:5432.
DATABASE_URL=postgres://moviemix:moviemix_dev@localhost:5433/moviemix
PORT=3333

# Token de leitura da TMDB. Obtenha o seu e mantenha-o apenas no .env local.
TMDB_READ_ACCESS_TOKEN=
